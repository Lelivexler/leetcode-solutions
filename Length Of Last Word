class Solution:
    def lengthOfLastWord(self, s: str) -> int:

        # i = pointer starting from the last character in the string
        i = len(s) - 1

        # stores the length of the last word
        my_sum = 0

        # skip trailing spaces at the end of the string
        while s[i] == " ":
            i -= 1

        # count characters of the last word
        while i >= 0 and s[i] != " ":
            my_sum += 1
            i -= 1

        return my_sum


# Time Complexity: O(n) - The string is scanned from the end at most once.

# Space Complexity: O(1) - Only constant extra variables are used, no additional data structures.
