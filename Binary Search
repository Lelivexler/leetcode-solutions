class Solution:
    def search(self, nums: List[int], target: int) -> int:

        # Initialize pointers for the left and right boundaries
        l = 0
        r = len(nums) - 1

        # Continue searching while the search range is valid
        while l <= r:

            # Calculate the middle index
            mid = (l + r) // 2

            # If the target is found, return its index
            if nums[mid] == target:
                return mid

            # If the target is larger, search in the right half
            elif nums[mid] < target:
                l = mid + 1

            # If the target is smaller, search in the left half
            else:
                r = mid - 1

        # If the target does not exist in the array, return -1
        return -1

        # Time complexity: O(log n) - Each step cuts the search range in half.

        # Space complexity: O(1) - Only constant extra space is used.
